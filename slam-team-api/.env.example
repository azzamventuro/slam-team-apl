# App
APP_ENV=development        # development | production
APP_PORT=8080

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=slamteam_db
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# JWT (HS256)
JWT_SECRET=change-me-in-production
JWT_ISSUER=slam-team-api
JWT_TTL_HOURS=24

# Redis (optional — leave REDIS_ADDR empty to disable)
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
