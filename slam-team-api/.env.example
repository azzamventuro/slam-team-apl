# App
APP_ENV=development        # development | production
APP_PORT=8080
APP_VERSION=dev            # build version reported by GET /health
APP_TIMEZONE=Asia/Jakarta  # default IANA zone for users & schedules

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=slamteam_db
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# JWT (HS256)
JWT_SECRET=change-me-in-production
JWT_ISSUER=slam-team-api
JWT_TTL_HOURS=24
JWT_REFRESH_TTL_HOURS=720

# Redis (optional — leave REDIS_ADDR empty to disable)
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# CORS (comma-separated origin allowlist; never "*" with credentials on)
CORS_ORIGINS=http://localhost:4200
CORS_ALLOW_CREDENTIALS=true

# File uploads
FILE_MAX_UPLOAD_MB=15
# Where uploaded bytes live: {STORAGE_ROOT}/{kategori}/{tahun}/{bulan}/{uuid}/
# Must be writable by the API process. Private files are NEVER served from here
# by nginx — only by GET /api/v1/files/{uuid}/{varian}.
# nginx in front of the API needs client_max_body_size >= FILE_MAX_UPLOAD_MB.
STORAGE_ROOT=./storage

# slamctl create-superadmin — password source, keeps it out of shell history
# SLAMCTL_SUPERADMIN_PASSWORD=
