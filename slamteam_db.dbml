// =====================================================================
//  RELASI
// =====================================================================

// Hak akses
Ref: mst_permission.modul_id       > mst_modul.id
Ref: role_permission.role_id       > mst_role.id      [delete: cascade]
Ref: role_permission.permission_id > mst_permission.id
Ref: user_role.user_id             > users.id         [delete: cascade]
Ref: user_role.role_id             > mst_role.id
Ref: users.role_id                 > mst_role.id      [delete: restrict]

// Sistem
Ref: mst_pengaturan.modified_by    > users.id
Ref: notifikasi.user_id            > users.id         [delete: cascade]
Ref: notifikasi.created_by         > users.id
Ref: log_aktivitas.aktor_user_id   > users.id
Ref: sesi_login.user_id            > users.id         [delete: cascade]

// Identitas & KTA
Ref: users.anggota_id              > anggota.id       [delete: restrict]
Ref: anggota.instansi_id           > mst_instansi.id  [delete: restrict]
Ref: anggota.wilayah_id            > mst_wilayah.id
Ref: anggota.foto_profil_file_id   > mst_file.id
Ref: anggota.foto_formal_file_id   > mst_file.id
Ref: anggota.file_identitas_file_id > mst_file.id
Ref: kta.anggota_id                > anggota.id       [delete: restrict]
Ref: kta.file_kta_id               > mst_file.id
Ref: kta.dicetak_oleh              > users.id
Ref: kta.dicabut_oleh              > users.id

// File
Ref: mst_file_varian.file_id       > mst_file.id      [delete: cascade]

// Jadwal
Ref: mst_lokasi.foto_file_id       > mst_file.id
Ref: jadwal.lokasi_id              > mst_lokasi.id    [delete: restrict]
Ref: jadwal.kegiatan_id            > kegiatan.id
Ref: jadwal.inorga_id              > mst_inorga.id
Ref: jadwal_sesi.jadwal_id         > jadwal.id        [delete: restrict]
Ref: jadwal_peserta.jadwal_id      > jadwal.id        [delete: restrict]
Ref: jadwal_peserta.sesi_id        > jadwal_sesi.id
Ref: jadwal_peserta.anggota_id     > anggota.id       [delete: restrict]
Ref: jadwal_peserta.ditugaskan_oleh > users.id

// Absensi
Ref: absensi.sesi_id               > jadwal_sesi.id   [delete: restrict]
Ref: absensi.jadwal_id             > jadwal.id        [delete: restrict]
Ref: absensi.anggota_id            > anggota.id       [delete: restrict]
Ref: absensi.user_id               > users.id         [delete: restrict]
Ref: absensi.foto_file_id          > mst_file.id
Ref: absensi.override_oleh         > users.id
Ref: absensi.izin_id               > absensi_izin.id
Ref: absensi_izin.sesi_id          > jadwal_sesi.id   [delete: restrict]
Ref: absensi_izin.jadwal_id        > jadwal.id
Ref: absensi_izin.anggota_id       > anggota.id       [delete: restrict]
Ref: absensi_izin.lampiran_file_id > mst_file.id
Ref: absensi_izin.diproses_oleh    > users.id
Ref: absensi_rekap.anggota_id      > anggota.id       [delete: restrict]

// Konten & master
Ref: kegiatan.user_id                    > users.id
Ref: kegiatan.gambar_highlight_file_id   > mst_file.id
Ref: artikel.user_id                     > users.id
Ref: artikel.gambar_highlight_file_id    > mst_file.id
Ref: unit.anggota_id                     > anggota.id
Ref: unit.foto_sampul_file_id            > mst_file.id
Ref: unit.disetujui_oleh                 > users.id
Ref: prestasi.anggota_id                 > anggota.id
Ref: prestasi.flyer_file_id              > mst_file.id
Ref: prestasi.foto_sampul_file_id        > mst_file.id
Ref: mst_instansi.logo_utama_file_id     > mst_file.id
Ref: mst_instansi.logo_tambahan_file_id  > mst_file.id
Ref: profile_club.banner_file_id         > mst_file.id
Ref: profile_club.logo_simple_file_id    > mst_file.id
Ref: profile_club.logo_besar_file_id     > mst_file.id
Ref: mst_inorga.logo_file_id             > mst_file.id
Ref: mst_inorga.banner_file_id           > mst_file.id
Ref: mst_inorga.file_sk_file_id          > mst_file.id
Ref: mst_medsos.anggota_id               > anggota.id
Ref: mst_dokumen.file_id                 > mst_file.id


// =====================================================================
//  PENGELOMPOKAN
// =====================================================================

TableGroup "1 · Hak Akses" {
  mst_modul
  mst_permission
  mst_role
  role_permission
  user_role
}

TableGroup "2 · Sistem" {
  mst_pengaturan
  notifikasi
  log_aktivitas
  sesi_login
}

TableGroup "3 · Identitas & KTA" {
  users
  anggota
  kta
  mst_wilayah
  mst_instansi
}

TableGroup "4 · File" {
  mst_file
  mst_file_varian
}

TableGroup "5 · Jadwal" {
  mst_lokasi
  jadwal
  jadwal_sesi
  jadwal_peserta
}

TableGroup "6 · Absensi" {
  absensi
  absensi_izin
  absensi_rekap
}

TableGroup "7 · Konten & Master" {
  kegiatan
  artikel
  unit
  prestasi
  profile_club
  mst_inorga
  mst_medsos
  mst_dokumen
}
